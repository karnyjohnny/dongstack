# DongStack — szablon konfiguracji lokalnej.
# Skopiuj do `.env` i uzupełnij WŁASNYMI wartościami. Plik `.env` jest w .gitignore!
#
# Jak zdobyć Client ID (darmowe, 2 minuty):
#   1. Zaloguj się na https://myanimelist.net
#   2. Account Settings → API → Create ID (aplikacja typu "web")
#   3. Skopiuj Client ID tutaj
#
# Bez Client ID aplikacja działa w trybie awaryjnym (provider AniList, bez rejestracji).

MAL_CLIENT_ID=twoj_client_id_tutaj

# Client Secret NIE jest potrzebny do żadnej funkcji DongStack v1
# (publiczne endpointy MAL używają wyłącznie nagłówka X-MAL-CLIENT-ID).
# Pole istnieje wyłącznie na przyszłość (OAuth2 w v2). NIGDY go nie commituj.
MAL_CLIENT_SECRET=

# Opcjonalne nadpisy:
# DONGSTACK_PREFERRED_PROVIDER=mal        # mal | anilist
# DONGSTACK_HOME=                          # katalog danych (domyślnie %LOCALAPPDATA%\DongStack)
# DONGSTACK_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
